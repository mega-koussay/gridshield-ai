# GridShield AI configuration (copy to .env and adjust if needed).
# Every value has a safe default; the PoC runs fine with no .env at all.

# --- Server ---
GRIDSHIELD_HOST=127.0.0.1
GRIDSHIELD_PORT=8000
GRIDSHIELD_LOG_LEVEL=info

# --- Determinism: change the seed to explore a different but reproducible world ---
GRIDSHIELD_SEED=20260925
GRIDSHIELD_SCENARIO_SEED=2026

# --- Simulation clock ---
GRIDSHIELD_TICK_SECONDS=1.0          # real seconds between live updates
GRIDSHIELD_STEP_MINUTES=5            # simulated minutes per step

# --- Microgrid sizing ---
GRIDSHIELD_SOLAR_KW=250
GRIDSHIELD_BATTERY_KWH=500
GRIDSHIELD_BATTERY_KW=200
GRIDSHIELD_GRID_LIMIT_KW=400
GRIDSHIELD_BUILDINGS=6

# --- One-click demo ---
GRIDSHIELD_ATTACK_START_MIN=0        # delay before the strike
GRIDSHIELD_ATTACK_DURATION_MIN=30
